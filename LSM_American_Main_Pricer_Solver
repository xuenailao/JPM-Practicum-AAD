from __future__ import annotations
import numpy as np
from dataclasses import dataclass
from typing import Optional, Tuple, Callable
import math
import time

Array = np.ndarray

# =========================
# Hand-written 3x3 solver
# =========================
def _solve_3x3(A: List[List[float]], b: List[float], ridge: float = 1e-10) -> List[float]:
    """Solve (A + ridge*I) x = b for 3x3 A via Gaussian elimination (partial pivot)."""
    M = [row[:] for row in A]
    for i in range(3):
        M[i][i] += ridge
    M = [M[0] + [b[0]], M[1] + [b[1]], M[2] + [b[2]]]
    for col in range(3):
        piv = col
        maxabs = abs(M[col][col])
        for r in range(col + 1, 3):
            if abs(M[r][col]) > maxabs:
                maxabs = abs(M[r][col]); piv = r
        if maxabs < 1e-18:
            return [0.0, 0.0, 0.0]
        if piv != col:
            M[col], M[piv] = M[piv], M[col]
        fac = M[col][col]
        for c in range(col, 4):
            M[col][c] /= fac
        for r in range(col + 1, 3):
            fac = M[r][col]
            for c in range(col, 4):
                M[r][c] -= fac * M[col][c]
    x = [0.0, 0.0, 0.0]
    for i in (2, 1, 0):
        s = M[i][3]
        for c in range(i + 1, 3):
            s -= M[i][c] * x[c]
        x[i] = s
    return x

@dataclass
class AMCPaths:
    S: Array         # (P, M+1)
    Z: Optional[Array]  # (P, M)
    t: Array         # (M+1,)    t[0]=0, t[-1]=T
    disc: float      # exp(-r*dt)
    dt: float        # T/M
    r: float         # risk-free rate
    q: float         # dividend yield
    sigma: float     # volatility
    S0: float        # initial price


# -----------------------------
# 1) risk neutral GBM path
# -----------------------------
def make_Z_antithetic(P: int, M: int, seed: Optional[int] = None, dtype=np.float64) -> Array:
    rng = np.random.default_rng(seed)
    half = (P + 1) // 2
    Zh = rng.standard_normal((half, M), dtype=dtype)
    Z  = np.concatenate([Zh, -Zh], axis=0)[:P, :]
    return Z


def simulate_gbm_paths(
    S0: float,
    r: float,
    q: float,
    sigma: float,
    T: float,
    M: int,
    P: int,
    *,
    seed: Optional[int] = None,
    antithetic: bool = True,
    return_Z: bool = True,
    dtype=np.float64,
    Z: Optional[Array] = None,
) -> AMCPaths:
    if M <= 0 or P <= 0:
        raise ValueError("M and P must be positive integers.")
    if sigma < 0:
        raise ValueError("sigma must be nonnegative.")
    if T < 0:
        raise ValueError("T must be nonnegative.")

    dt = T / M
    t  = np.linspace(0.0, T, M + 1, dtype=dtype)
    mu_step  = (r - q - 0.5 * sigma * sigma) * dt
    vol_step = sigma * np.sqrt(dt)

    # --- Z: ---
    if Z is not None:
        Z_used = np.asarray(Z, dtype=dtype)
        if Z_used.shape != (P, M):
            raise ValueError(f"Provided Z must have shape (P, M)=({P}, {M}), got {Z_used.shape}.")
    else:
        if antithetic:
            Z_used = make_Z_antithetic(P, M, seed=seed, dtype=dtype)
        else:
            rng = np.random.default_rng(seed)
            Z_used = rng.standard_normal((P, M), dtype=dtype)

    log_inc = mu_step + vol_step * Z_used              # (P, M)
    np.cumsum(log_inc, axis=1, out=log_inc)
    S = np.empty((P, M + 1), dtype=dtype)
    S[:, 0]  = S0
    np.exp(log_inc, out=log_inc)
    S[:, 1:] = S0 * log_inc

    disc = float(np.exp(-r * dt))
    return AMCPaths(S=S, Z=Z_used if return_Z else None, t=t, disc=disc, dt=dt,
                    r=r, q=q, sigma=sigma, S0=S0)


