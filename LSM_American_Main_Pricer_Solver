@dataclass
class LSMResult:
    price: float          # Option price estimate
    stderr: float         # Standard error of the estimate
    C_path: Array         # Present value of each path at t=0 (shape (P,))
    exercised: Array      # Indicator whether early exercise occurred (P,)
    tau_idx: Array        # First exercise time index per path (P,); 0 means exercised at maturity
    r2: Array             # Regression R² at each time step (length M-1, in chronological order)
    itm_counts: Array     # Number of in-the-money samples per step (same as above)
    betas: list           # Regression coefficients β at each step (or NaN if not available)

# 3*3 Solver case-----------------------------------------------------
def _lsm_single_pack(
    pack: AMCPaths, K: float,
    payoff_now: Callable[[Array, float], Array],   
) -> LSMResult:
    start = time.perf_counter()
    S, disc = pack.S, pack.disc
    P, M1 = S.shape
    M = M1 - 1

    C = payoff_now(S[:, M], K).astype(S.dtype, copy=False)
    r2_list, itm_list, betas = [], [], []
    tau_idx = np.zeros(P, dtype=np.int32)
    exercised = np.zeros(P, dtype=bool)

    for m in range(M - 1, 0, -1):
        Sm = S[:, m]
        E  = payoff_now(Sm, K)
        itm = (E > 0.0)
        itm_list.append(int(itm.sum()))

        if np.any(itm):
            S_itm = Sm[itm]
            y     = disc * C[itm]
            beta  = _ols_beta_poly2_fast(S_itm, y)      
            betas.append(np.array(beta, dtype=S.dtype)) 
            y_hat = _yhat_poly2(beta, S_itm)

            # R^2
            mu = float(np.mean(y)) if y.size > 0 else float('nan')
            ss_res = float(np.sum((y - y_hat)**2)) if y.size > 0 else float('nan')
            ss_tot = float(np.sum((y - mu)**2)) if y.size > 1 else float('nan')
            r2 = 1.0 - ss_res / ss_tot if (np.isfinite(ss_tot) and ss_tot > 0) else np.nan
            r2_list.append(r2)

            C_hat = np.zeros(P, dtype=S.dtype)
            C_hat[itm] = y_hat
        else:
            betas.append(np.array([np.nan, np.nan, np.nan], dtype=S.dtype))
            r2_list.append(np.nan)
            C_hat = np.zeros(P, dtype=S.dtype)

        exer = (E > 0.0) & (E >= C_hat)
        cont = ~exer

        new_ex = exer & (~exercised)
        tau_idx[new_ex] = m
        exercised[new_ex] = True

        C[exer] = E[exer]
        C[cont] = disc * C[cont]

    C0 = C
    price  = float(C0.mean())
    stderr = float(C0.std(ddof=1) / np.sqrt(P))

    r2_arr  = np.array(r2_list[::-1])
    itm_arr = np.array(itm_list[::-1])
    betas.reverse()
    end = time.perf_counter()
    print(f"运行时间: {end - start:.6f} 秒")

    return LSMResult(price=price, stderr=stderr, C_path=C0,
                     exercised=exercised, tau_idx=tau_idx,
                     r2=r2_arr, itm_counts=itm_arr, betas=betas)

def lsm_price(
    pack: AMCPaths, K: float,
    payoff_now: Callable[[Array, float], Array],
    *, twin_pack: Optional[AMCPaths] = None,
) -> LSMResult:
    res_pos = _lsm_single_pack(pack, K, payoff_now)
    if twin_pack is None:
        return res_pos
    res_neg = _lsm_single_pack(twin_pack, K, payoff_now)

    C_avg = 0.5 * (res_pos.C_path + res_neg.C_path)
    P = C_avg.shape[0]
    price  = float(np.mean(C_avg))
    stderr = float(np.std(C_avg, ddof=1) / np.sqrt(P))
    r2 = np.nanmean(np.vstack([res_pos.r2, res_neg.r2]), axis=0)
    itm_counts = 0.5 * (res_pos.itm_counts + res_neg.itm_counts) 
    return LSMResult(price=price, stderr=stderr, C_path=C_avg,
                     exercised=(res_pos.exercised | res_neg.exercised),
                     tau_idx=np.minimum(res_pos.tau_idx, res_neg.tau_idx),
                     r2=r2, itm_counts=itm_counts, betas=[res_pos.betas, res_neg.betas])
