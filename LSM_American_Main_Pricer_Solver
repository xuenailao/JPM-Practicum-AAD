# 3*3 Solver case-----------------------------------------------------
def _ols_beta_poly2_fast(S_itm: Array, y: Array) -> List[float]:
    """
    Solve min ||Xβ - y|| with X=[1, S, S^2] via normal equations:
      XtX = [[Σ1, ΣS, ΣS2],
             [ΣS, ΣS2, ΣS3],
             [ΣS2,ΣS3, ΣS4]],
      Xty = [Σy, Σ(Sy), Σ(S^2 y)]
    """
    S_itm = np.asarray(S_itm, dtype=float)
    y     = np.asarray(y, dtype=float)
    n  = S_itm.size
    if n == 0:
        return [np.nan, np.nan, np.nan]

    S   = S_itm
    S2  = S * S
    S3  = S2 * S
    S4  = S2 * S2

    s1  = float(n)
    sS  = float(np.sum(S))
    s2  = float(np.sum(S2))
    s3  = float(np.sum(S3))
    s4  = float(np.sum(S4))

    sy  = float(np.sum(y))
    sSy = float(np.sum(S * y))
    s2y = float(np.sum(S2 * y))

    XtX = [[s1, sS, s2],
           [sS, s2, s3],
           [s2, s3, s4]]
    Xty = [sy, sSy, s2y]
    return _solve_3x3(XtX, Xty, ridge=1e-10)

def _yhat_poly2(beta: List[float], S_itm: Array) -> Array:
    b0, b1, b2 = beta
    S = np.asarray(S_itm, dtype=float)
    return b0 + b1*S + b2*(S*S)
