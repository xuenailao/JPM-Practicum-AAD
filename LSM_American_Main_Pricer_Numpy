# 10) run_compare_american: read CSV -> LSM + FD + AAD table
# ------------------------------------------------------------
import pandas as pd
from scipy.special import erfinv

def _infer_S0_from_delta(K: float, r: float, q: float, sigma: float, T: float,
                         delta_csv: float, is_call: bool) -> float:

    if is_call:
        p = np.clip(delta_csv * np.exp(q * T), 1e-8, 1 - 1e-8)
        d1 = np.sqrt(2) * erfinv(2 * p - 1)
    else:
        p = np.clip(-delta_csv * np.exp(q * T), 1e-8, 1 - 1e-8)
        d1 = -np.sqrt(2) * erfinv(2 * p - 1)
    lnS_over_K = sigma * np.sqrt(T) * d1 - (r - q + 0.5 * sigma * sigma) * T
    return K * np.exp(lnS_over_K)

def run_compare_american(csv_path, row_idxs,
                         r=0.05, q=0.0, M=50, P=50_000, seed=42,
                         strike_div_1000=True,
                         basis="poly3", option_hint=None,
                         use_underlying_cols=True,
                         S0_override=None):

    df = pd.read_csv(csv_path)
    df["date"] = pd.to_datetime(df["date"])
    df["exdate"] = pd.to_datetime(df["exdate"])

    out_rows = []
    for i in row_idxs:
        row = df.iloc[i]
        T = (row["exdate"] - row["date"]).days / 365.0
        K_raw = float(row["strike_price"])
        K = K_raw / 1000.0 if strike_div_1000 else K_raw
        sigma = float(row["impl_volatility"])
        flag = (option_hint or str(row.get("cp_flag", "P")).upper())
        is_call = (flag == "C")
        payoff_now = payoff_call_now if is_call else payoff_put_now
        basis_fn = basis_poly3 if basis == "poly3" else basis_poly2

        # --- S0: prefer underlying/Close; otherwise back out from (delta, iv) ---
        S0 = None
        if use_underlying_cols:
            for cands in [("underlying_bid_1545","underlying_ask_1545"),
                          ("underlying_bid","underlying_ask"),
                          ("underlying_price",), ("spot",), ("Close",),
                          ("Adj Close",), ("price",)]:
                if len(cands) == 2 and cands[0] in df.columns and cands[1] in df.columns:
                    b, a = row.get(cands[0], np.nan), row.get(cands[1], np.nan)
                    if np.isfinite(b) and np.isfinite(a):
                        S0 = 0.5 * (float(b) + float(a)); break
                elif len(cands) == 1 and cands[0] in df.columns:
                    val = row.get(cands[0], np.nan)
                    if np.isfinite(val):
                        S0 = float(val); break
        if S0_override is not None:
            S0 = S0_override
        if S0 is None:
            delta_csv = float(row.get("delta", 0.0))
            S0 = _infer_S0_from_delta(K, r, q, sigma, T, delta_csv, is_call=is_call)

        # --- FD Greeks + baseline LSM price ---
        fd, base_res, base_pack = fd_greeks(
            S0, K, r, q, sigma, T, M, P, payoff_now, basis_fn, seed=seed
        )

        # --- AAD Frozen (freeze at LSM's tau_idx) ---
        aad = aad_frozen_greeks(base_pack, base_res, K, payoff_now)

        # --- Market columns (if present) ---
        mkt_delta = row["delta"] if "delta" in df.columns else np.nan
        mkt_gamma = row["gamma"] if "gamma" in df.columns else np.nan

        out_rows.append(dict(
            idx=i, K=K, T=T,
            lsm_price=base_res.price,
            fd_delta=fd["delta"], fd_gamma=fd["gamma"], fd_vega=fd["vega"],
            aad_delta=aad["delta"], aad_vega=aad["vega"],
            mkt_delta=mkt_delta, mkt_gamma=mkt_gamma
        ))

    return pd.DataFrame(out_rows)

