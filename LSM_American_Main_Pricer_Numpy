def basis_poly2(x: Array) -> Array:
    x = np.asarray(x).reshape(-1, 1)
    return np.column_stack([np.ones_like(x), x, x**2])

def basis_poly3(x: Array) -> Array:
    x = np.asarray(x).reshape(-1, 1)
    return np.column_stack([np.ones_like(x), x, x**2, x**3])

