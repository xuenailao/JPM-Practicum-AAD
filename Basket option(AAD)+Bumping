    rho = 0.3                         # correlation coefficient
    n_paths, n_steps = 100, 100       # number of MC paths and steps
    rng = np.random.default_rng(12345)

    # Loop over different numbers of assets
    for n_assets in range(15, 21, 5):
        start_time = time.time()
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        print(f"\n[{now}] Running with n_assets = {n_assets}")

        # Initialize parameters
        S0 = np.linspace(90, 110, n_assets)                # linearly spaced initial prices
        sigma = np.linspace(0.15, 0.30, n_assets)          # linearly spaced volatilities
        weights = np.ones(n_assets) / n_assets             # equal basket weights
        corr_matrix = rho * np.ones((n_assets, n_assets)) + (1 - rho) * np.eye(n_assets)  
        Z_paths = rng.standard_normal(size=(n_paths, n_steps, n_assets))  

        # Run AAD + Pathwise Monte Carlo
        price, delta, vega, rho_out = basket_call_pathwise_aad_all_greeks(
            S0, K, r0, sigma, T, weights, corr_matrix, Z_paths, n_steps
        )

        # Print results
        elapsed = time.time() - start_time
        print("  Price:", price)
        print("  Delta:", delta)
        print("  Vega:", vega)
        print("  Rho:", rho_out)
        print(f"  Time elapsed: {elapsed:.2f} seconds")

# ------------------ Bumping Pricing ------------------
def basket_call_price_mc(S0, K, r, sigma, T, weights, corr_matrix,
                         Z_paths, n_steps=100):
    """
    Classical Monte Carlo pricing of a basket European call option.

    Parameters:
        S0: initial asset prices (array)
        K: strike price
        r: risk-free rate
        sigma: volatilities (array)
        T: maturity
        weights: basket weights
        corr_matrix: correlation matrix
        Z_paths: pre-generated standard normal random numbers
        n_steps: number of time steps

    Returns:
        Monte Carlo estimate of the option price
    """
    # Convert inputs to numpy arrays for vectorization
    S0 = np.array(S0, dtype=float)
    sigma = np.array(sigma, dtype=float)
    weights = np.array(weights, dtype=float)
    n_assets = len(S0)
    dt = T / n_steps   # time step length

    # ------------------ Cholesky Decomposition (introducing correlation) ------------------
    epsilon = 1e-12   # small perturbation to ensure matrix is non-singular
    R = np.array(corr_matrix, dtype=float) + epsilon * np.eye(n_assets)
    L = np.linalg.cholesky(R)   # lower triangular matrix, R = L Lᵀ

    price_paths, n_paths = [], Z_paths.shape[0]

    # ------------------ Simulate each path ------------------
    for path_idx in range(n_paths):
        S = S0.copy()   # initialize asset prices for this path
        for step in range(n_steps):
            Z = Z_paths[path_idx, step, :]   # normal draws for this step
            dW = L @ Z * np.sqrt(dt)         # correlated Brownian increments
            # Update asset prices with GBM dynamics
            S = S * np.exp((r - 0.5 * sigma**2) * dt + sigma * dW)

        # Compute basket option payoff
        basket_val = np.dot(weights, S)       # weighted sum of terminal prices
        payoff = max(basket_val - K, 0)       # European call payoff
        price_paths.append(payoff * np.exp(-r * T))  # discounted payoff

    return np.mean(price_paths)   # Monte Carlo estimate of option price


# ------------------ Finite Difference Greeks ------------------
def finite_diff_greeks(S0, K, r, sigma, T, weights, corr_matrix,
                       Z_paths, eps=1e-3, n_steps=100):
    """
    Compute Greeks (Delta, Vega, Rho) using finite difference method.

    Parameters:
        eps: perturbation size for finite difference approximation
    """
    n_assets = len(S0)
    delta_fd = np.zeros(n_assets)  # Delta per asset
    vega_fd = np.zeros(n_assets)   # Vega per asset

    # ------------------ Base price ------------------
    price = basket_call_price_mc(S0, K, r, sigma, T, weights, corr_matrix, Z_paths, n_steps)

    # ------------------ Delta ------------------
    for i in range(n_assets):
        S_up, S_down = S0.copy(), S0.copy()
        S_up[i] += eps       # perturb upward
        S_down[i] -= eps     # perturb downward
        p_up = basket_call_price_mc(S_up, K, r, sigma, T, weights, corr_matrix, Z_paths, n_steps)
        p_down = basket_call_price_mc(S_down, K, r, sigma, T, weights, corr_matrix, Z_paths, n_steps)
        delta_fd[i] = (p_up - p_down) / (2 * eps)   # central difference

    # ------------------ Vega ------------------
    for i in range(n_assets):
        sigma_up, sigma_down = sigma.copy(), sigma.copy()
        sigma_up[i] += eps
        sigma_down[i] -= eps
        p_up = basket_call_price_mc(S0, K, r, sigma_up, T, weights, corr_matrix, Z_paths, n_steps)
        p_down = basket_call_price_mc(S0, K, r, sigma_down, T, weights, corr_matrix, Z_paths, n_steps)
        vega_fd[i] = (p_up - p_down) / (2 * eps)   # central difference

    # ------------------ Rho ------------------
    p_up = basket_call_price_mc(S0, K, r + eps, sigma, T, weights, corr_matrix, Z_paths, n_steps)
    p_down = basket_call_price_mc(S0, K, r - eps, sigma, T, weights, corr_matrix, Z_paths, n_steps)
    rho_fd = (p_up - p_down) / (2 * eps)

    return price, delta_fd, vega_fd, rho_fd


